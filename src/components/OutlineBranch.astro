---
import type { OutlineNode } from '../lib/outline.mjs';
interface Props { nodes: OutlineNode[]; }
const { nodes } = Astro.props;
---
<ol>
  {nodes.map(node => (
    <li>
      <a href={`#${encodeURIComponent(node.slug)}`} data-heading-id={node.slug} title={node.text}>{node.text}</a>
      {node.children.length > 0 && <Astro.self nodes={node.children} />}
    </li>
  ))}
</ol>
