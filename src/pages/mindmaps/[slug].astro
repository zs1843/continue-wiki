---
import { parse } from '@markmap/parse';
import Notebook from '../../layouts/Notebook.astro';
import { publishedMindmaps, type Mindmap } from '../../lib/mindmaps';
import { noteHref } from '../../../scripts/mindmaps.mjs';
import '../../styles/mindmaps.css';
export async function getStaticPaths() {
  return (await publishedMindmaps()).map(map => ({ params: { slug: map.slug }, props: { map } }));
}
const { map } = Astro.props as { map: Mindmap };
const { root } = parse(map.markdown);
const serialized = JSON.stringify(root).replaceAll('<', '\\u003c');
---
<Notebook title={map.title} currentMap={map.slug} folders={['思维导图']} updated={map.updated} indexable={false} wide>
  <div class="map-summary"><a href="/mindmaps/">← 全部导图</a><span>{map.noteCount} 篇笔记 · {map.pointCount} 个知识点</span></div>
  <section class="map-viewer" aria-label={`${map.title}思维导图`}>
    <div class="map-toolbar" role="group" aria-label="导图操作">
      <span class="map-toolbar-title">{map.title}</span>
      <div class="map-zoom-controls">
        <button type="button" data-map-action="zoom-out" aria-label="缩小导图" title="缩小">−</button>
        <button type="button" data-map-action="zoom-in" aria-label="放大导图" title="放大">＋</button>
        <button type="button" data-map-action="fit">适应画布</button>
      </div>
      <div class="map-branch-controls">
        <button type="button" data-map-action="expand">展开全部</button>
        <button type="button" data-map-action="collapse">收起分支</button>
      </div>
      <button class="map-fullscreen" type="button" data-map-action="fullscreen" aria-pressed="false"><svg viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M7 3H3v4m10-4h4v4M3 13v4h4m10-4v4h-4"/></svg><span>全屏查看</span></button>
    </div>
    <div class="map-canvas">
      <svg class="knowledge-map" role="group" aria-label={`${map.title}，点击节点文字打开笔记，点击圆点展开或收起分支`} tabindex="0"></svg>
      <p class="map-loading" role="status">正在展开知识点…</p>
    </div>
    <div class="map-help"><span>拖动画布移动 · 滚轮缩放 · 点击圆点展开</span><span>点击知识点查看笔记 ↗</span></div>
    <p class="map-status" role="status" aria-live="polite"></p>
    <script id="mindmap-data" type="application/json" is:inline set:html={serialized}></script>
  </section>
  <details class="map-outline">
    <summary>按列表阅读知识点</summary>
    {map.groups.map(group => (
      <div>
        <h2>{group.label}</h2>
        <ul>{group.notes.map(note => (
          <li><a href={noteHref(note)}>{note.title}</a>
            {(note.mindmap?.length ?? 0) > 0 && <ul>{note.mindmap?.map(point => <li><a href={noteHref(note, point)}>{point.label}</a></li>)}</ul>}
          </li>
        ))}</ul>
      </div>
    ))}
  </details>
  <script src="../../scripts/mindmap.ts"></script>
</Notebook>
